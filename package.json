{
  "name": "wardley-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "NEXT_DIST_DIR=.next-e2e next build",
    "test:e2e": "playwright test",
    "pretest:performance": "NEXT_DIST_DIR=.next-e2e next build",
    "test:performance": "playwright test --project=performance --no-deps --workers=1",
    "pretest:visual": "NEXT_DIST_DIR=.next-e2e next build",
    "test:visual": "playwright test --project=visual --no-deps --workers=1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.3.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
